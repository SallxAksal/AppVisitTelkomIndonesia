<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_telkom"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center"
        android:background="@drawable/card_bg"
        android:elevation="8dp"
        android:padding="24dp"
        android:layout_margin="16dp">

        <!-- Logo Telkom -->


        <!-- Sub Judul -->
        <ImageView
            android:id="@+id/logoTelkom"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Logo Telkom"
            android:src="@drawable/telkom" />

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="serif"
            android:text="Selamat Datang"
            android:textColor="#212121"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WITEL BANDUNG"
            android:textSize="14sp"
            android:textColor="#9E9E9E"
            android:layout_marginBottom="16dp" />

        <!-- Garis Pemisah -->

        <!-- Selamat Datang -->

        <!-- Tombol Menu -->

        <View
            android:layout_width="100dp"
            android:layout_height="2dp"
            android:layout_marginBottom="20dp"
            android:background="#E60000" />

        <Button
            android:id="@+id/btnVisit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Form Input Visit"
            android:background="@drawable/btn_outline"
            android:textColor="#212121"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSurvey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Form Input Survey"
            android:background="@drawable/btn_outline"
            android:textColor="#212121"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📂 Lihat Data"
            android:background="@drawable/btn_outline"
            android:textColor="#212121"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄 Export ke PDF"
            android:background="@drawable/btn_gold"
            android:textColor="#212121" />
    </LinearLayout>
</ScrollView>